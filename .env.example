# HC Agency — Environment Variables
# Copy this file to .env and set your keys when hosting on Vercel, Netlify, or Node.js server.
# NEVER commit the real .env file to GitHub!

# AI API Key (Gemini or OpenAI) — Required for AI chat assistant & blog generation
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Blob Storage Token — Required for blog persistence on Vercel
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Cron Secret — Required to authenticate /api/generate-blog requests
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this in Vercel Dashboard → Project Settings → Environment Variables
CRON_SECRET=your_cron_secret_here
